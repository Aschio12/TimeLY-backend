<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice {{invoiceNumber}}</title>
    <style>
        body {
            font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
            color: #333;
            background-color: #fff;
            margin: 0;
            padding: 40px;
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
            font-size: 16px;
            line-height: 24px;
        }
        .invoice-box table {
            width: 100%;
            line-height: inherit;
            text-align: left;
            border-collapse: collapse;
        }
        .invoice-box table td {
            padding: 5px;
            vertical-align: top;
        }
        .invoice-box table tr td:nth-child(2) {
            text-align: right;
        }
        .invoice-box table tr.top table td {
            padding-bottom: 20px;
        }
        .invoice-box table tr.top table td.title {
            font-size: 45px;
            line-height: 45px;
            color: #333;
        }
        .invoice-box table tr.information table td {
            padding-bottom: 40px;
        }
        .invoice-box table tr.heading td {
            background: #eee;
            border-bottom: 1px solid #ddd;
            font-weight: bold;
        }
        .invoice-box table tr.details td {
            padding-bottom: 20px;
        }
        .invoice-box table tr.item td {
            border-bottom: 1px solid #eee;
        }
        .invoice-box table tr.item.last td {
            border-bottom: none;
        }
        .invoice-box table tr.total td:nth-child(2) {
            border-top: 2px solid #eee;
            font-weight: bold;
        }
        .text-right {
            text-align: right;
        }
        .table-headers th {
            padding: 5px;
            background: #f5f5f5;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }
        .table-headers th.right {
            text-align: right;
        }
    </style>
</head>
<body>
    <div class="invoice-box">
        <table cellpadding="0" cellspacing="0">
            <tr class="top">
                <td colspan="4">
                    <table>
                        <tr>
                            <td class="title">
                                <!-- Placeholder for Company Logo -->
                                <h2 style="margin:0; font-size: 32px; color: #2C3E50;">TimeLY Enterprise</h2>
                            </td>
                            <td>
                                Invoice #: {{invoiceNumber}}<br>
                                Created: {{issueDate}}<br>
                                Due: {{dueDate}}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr class="information">
                <td colspan="4">
                    <table>
                        <tr>
                            <td>
                                <strong>From:</strong><br>
                                {{workspaceName}}<br>
                                hello@timely-enterprise.com
                            </td>
                            <td>
                                <strong>To:</strong><br>
                                {{clientName}}<br>
                                {{#if clientAddress}}
                                {{clientAddress}}
                                {{else}}
                                Client ID: {{clientId}}
                                {{/if}}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <table cellpadding="0" cellspacing="0" style="margin-top: 20px;">
            <tr class="heading table-headers">
                <th>Description</th>
                <th class="right">Quantity</th>
                <th class="right">Unit Price</th>
                <th class="right">Amount</th>
            </tr>
            {{#each lineItems}}
            <tr class="item">
                <td>{{description}}</td>
                <td class="text-right">{{quantity}}</td>
                <td class="text-right">{{formatCurrency unitPrice}}</td>
                <td class="text-right">{{formatCurrency amount}}</td>
            </tr>
            {{/each}}
            
            <tr class="total">
                <td colspan="2"></td>
                <td class="text-right" style="padding-top: 20px;">Subtotal:</td>
                <td class="text-right" style="padding-top: 20px;">{{formatCurrency subtotal}}</td>
            </tr>
            {{#if taxRate}}
            <tr class="total">
                <td colspan="2"></td>
                <td class="text-right">Tax ({{multiply taxRate 100}}%):</td>
                <td class="text-right">{{formatCurrency taxAmount}}</td>
            </tr>
            {{/if}}
            <tr class="total">
                <td colspan="2"></td>
                <td class="text-right" style="font-size: 1.2em;"><strong>Total:</strong></td>
                <td class="text-right" style="font-size: 1.2em;"><strong>{{formatCurrency total}}</strong></td>
            </tr>
        </table>
    </div>
</body>
</html>
